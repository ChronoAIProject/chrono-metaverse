{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "typeRoots": ["../../sdk/typescript/node_modules/@types", "../../web/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@chrono-metaverse/sdk": ["../../sdk/typescript/dist/index.d.ts"]
    }
  },
  "include": [
    "build/**/*.ts"
  ]
}
