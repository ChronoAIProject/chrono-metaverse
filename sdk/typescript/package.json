{
  "name": "@chrono-metaverse/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "chrono-metaverse 的建造脚本工具包和 metaverse 命令行（从检出的源码使用，不发布）",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "metaverse": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/mark-executable.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright-core": "1.58.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
